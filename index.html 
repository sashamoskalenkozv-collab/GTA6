<!DOCTYPE html>
<html lang="uk">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>GTA 6 Countdown</title>
    <link rel="stylesheet" href="stael.css">
</head>

<body>
    <div class="overlay"></div>

    <main class="hero">
        <p class="tag">Найочікуваніший реліз</p>
        <h1>GTA 6</h1>
        <p class="subtitle">До виходу</p>

        <div class="countdown" aria-label="таймер до релізу">
            <div class="time-box">
                <span id="days">00</span>
                <small>днів</small>
            </div>
            <div class="time-box">
                <span id="hours">00</span>
                <small>годин</small>
            </div>
            <div class="time-box">
                <span id="minutes">00</span>
                <small>хвилин</small>
            </div>
            <div class="time-box">
                <span id="seconds">00</span>
                <small>секунд</small>
            </div>
        </div>
    </main>

    <script src="srept.js"></script>
</body>

</html>